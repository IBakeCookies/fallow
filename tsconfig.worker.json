{
	// SvelteKit's generated tsconfig excludes src/service-worker.ts, so `npm run
	// check` would never type-check the file that intercepts every GET. It needs
	// its own program: worker globals instead of DOM, and no @types/node.
	"compilerOptions": {
		"lib": ["esnext", "WebWorker"],
		"types": [],
		// the worker imports the locale list from $lib/paraglide/runtime (a
		// generated .js file) — resolve the alias and admit the JS without
		// checking its internals (no "checkJs")
		"paths": { "$lib/*": ["./src/lib/*"] },
		"allowJs": true,
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/service-worker.ts"]
}
