# Canonical origin, no trailing slash. Set it on the production deployment
# only — preview deploys should keep it unset so they never advertise
# themselves as canonical.
#
# Unset: canonical/og tags, sitemap.xml and robots.txt fall back to the
# request origin, and the two crawler files are served dynamically.
# Set: they are prerendered to static files at build time.
PUBLIC_SITE_URL=https://example.com
CHROMATIC_PROJECT_TOKEN=